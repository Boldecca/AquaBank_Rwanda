# AquaBank Rwanda — Example environment variables
# Copy this file to `.env.local` and replace placeholders with real values.

# Firebase (client-side keys) - keep in NEXT_PUBLIC_* for client access
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# AI provider key (server or client depending on integration)
AI_API_KEY=YOUR_AI_API_KEY

# Maps / Geolocation (Mapbox / Google Maps)
NEXT_PUBLIC_MAPS_API_KEY=YOUR_MAPS_API_KEY

# Payment provider (demo by default). Example placeholders for Stripe and Mobile Money
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Mobile Money (gateway) placeholders - do NOT commit real secrets
MOMO_CLIENT_ID=your_momo_client_id
MOMO_CLIENT_SECRET=your_momo_secret

# Optional: analytics / monitoring
NEXT_PUBLIC_SENTRY_DSN=

# Notes:
# - Never commit secrets. Store production secrets in your hosting provider's secret manager.
# - Use `.env.local` for local development and add it to `.gitignore` (already excluded).
